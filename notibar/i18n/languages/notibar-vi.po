#. Plugin Name of the plugin
msgid "Notibar - WordPress Notification Bar"
msgstr "Notibar - Thanh thông báo WordPress"

#. Plugin URI of the plugin
msgid "https://ninjateam.org/notibar-wordpress-notification-bar"
msgstr "https://ninjateam.org/notibar-wordpress-notification-bar"

#. Description of the plugin
msgid ""
"Multiple notification bars with React-powered Customizer editor, live "
"preview, rotation mode, and per-bar display rules."
msgstr ""
"Nhiều thanh thông báo với trình chỉnh sửa Customizer chạy trên React, xem "
"trước trực tiếp, chế độ xoay vòng và quy tắc hiển thị riêng cho từng thanh."

#. Author of the plugin
msgid "Ninja Team"
msgstr "Ninja Team"

#. Author URI of the plugin
msgid "https://ninjateam.org"
msgstr "https://ninjateam.org"

